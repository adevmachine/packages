#!/usr/bin/env bash
set -euo pipefail

# The key lives where the credential says it lives. `devmachine` copies
# `stored_at` from here into every workspace that shares this login, so a key
# written anywhere else would be made and then never found.
key_dir="$HOME/.ssh"
key_file="$key_dir/id_ed25519"

# ssh-keygen refuses to overwrite an existing file without being asked, so a
# second run here is already a no-op on that front — the mkdir and chmod below
# are what make the whole script safe to run twice.
if [ ! -f "$key_file" ]; then
  mkdir -p "$key_dir"
  chmod 0700 "$key_dir"
  ssh-keygen -t ed25519 -N "" -C "devmachine" -f "$key_file"
fi
chmod 0600 "$key_file"

echo
echo "Public key:"
cat "$key_file.pub"
echo
echo "Register it at https://github.com/settings/ssh/new"
